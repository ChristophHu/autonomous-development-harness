# Local, non-secret configuration overrides. Copy to .env and edit as needed.
HARNESS_WORKSPACE=./workspace
OBSIDIAN_VAULT_PATH=./vault
QDRANT_URL=http://127.0.0.1:6333
QDRANT_COLLECTION=harness-memory
LLM_PROVIDER=lmstudio
# LLM_MODEL=your-exact-provider-model-id
LLM_API_URL=http://127.0.0.1:1234/v1
# GIT_REMOTE_URL=https://example.invalid/your/repository.git
API_HOST=127.0.0.1
API_PORT=8080

# Development-only fallback. Prefer the macOS Keychain for real credentials.
# OPENAI_API_KEY=
# OPENROUTER_API_KEY=
